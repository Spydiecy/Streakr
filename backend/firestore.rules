rules_version = '2';

// Streakr Firestore security rules.
//
// Trust model:
//   - Every write that affects streaks/XP/leaderboard/call settlement happens
//     server-side (Cloud Functions, admin SDK — which bypasses these rules
//     entirely). Clients can only create the initial "pending" call and read
//     data; they can never mark a call won/lost/void, mutate someone else's
//     streak, or edit the leaderboard themselves.
//   - This is deliberate: the whole point of Streakr is that outcomes are
//     read from the real on-chain settlement, not self-reported.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── users/{uid} ──────────────────────────────────────────────────────
    // Public profile fields anyone signed in can read (leaderboards, room
    // member lists). Only the owner can create/touch their own doc, and even
    // then only non-derived fields — xp/streak/badges are server-owned.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.xp == 0
        && request.resource.data.currentStreak == 0
        && request.resource.data.bestStreak == 0
        && (request.resource.data.badges == [] || !("badges" in request.resource.data));
      allow update: if isSelf(uid)
        // Owner may update their own display fields, never the derived
        // gamification fields — those only change via Cloud Functions
        // (admin SDK, which is not subject to these rules).
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["displayName", "walletAddress", "avatarUrl", "updatedAt"]);
      allow delete: if false;
    }

    // ── rooms/{roomId} ───────────────────────────────────────────────────
    match /rooms/{roomId} {
      allow read: if isSignedIn() && (resource.data.isPublic == true || request.auth.uid in resource.data.memberUids);
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;
      // Members can join a public room (append themselves) or the creator can
      // edit room metadata — but nobody can rewrite someone else's membership.
      allow update: if isSignedIn() && (
        // Joining: the only diff is this uid being added to memberUids.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUids"])
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.auth.uid in request.resource.data.memberUids)
        ||
        // Owner editing name/activeMarket/isPublic.
        (resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["name", "activeMarket", "isPublic"]))
      );
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // ── calls/{callId} ───────────────────────────────────────────────────
    match /calls/{callId} {
      allow read: if isSignedIn();
      // A user may only create their OWN call, in the required-pending
      // state, with no payout/settlement fields set yet. txHash/positionId
      // must already be present — Streakr never records a call that wasn't
      // actually signed and submitted on-chain.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.txHash is string && request.resource.data.txHash.size() > 0
        && request.resource.data.positionId is string && request.resource.data.positionId.size() > 0
        && !("payout" in request.resource.data)
        && !("settledAt" in request.resource.data);
      // Settlement (status/payout/settledAt) is admin-only — set by
      // onCallSettled / the settlement poller, never by a client.
      allow update: if false;
      allow delete: if false;
    }

    // ── leaderboard/{scope} (e.g. "global", or roomId) ──────────────────
    // Fully derived, fully server-written.
    match /leaderboard/{scope} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /leaderboard/{scope}/entries/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── resultCards/{cardId} ─────────────────────────────────────────────
    // Generated by onCallSettled; readable by anyone with the link (for
    // sharing to social — the whole point of the viral loop).
    match /resultCards/{cardId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
