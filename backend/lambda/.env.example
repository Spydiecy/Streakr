# Reference only — Lambda doesn't read a .env file at runtime. Set these as
# actual Environment Variables on each Lambda function in the console (see
# DEPLOY.md for exactly which vars each of the four functions needs).

# testnet | mainnet
NETWORK=testnet

# Full JSON key content from Firebase Console -> Project Settings ->
# Service Accounts -> Generate new private key. Required by ALL four
# functions (each talks to Firestore).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Required by pollPendingCalls only.
N8N_SETTLEMENT_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/streakr/settlement

# Required by preLockNudge only — must match the secret n8n's HTTP Request
# node sends in the x-streakr-secret header.
N8N_SHARED_SECRET=change-me

# Optional, sentiment only. Without this, sentiment falls back to a
# template sentence instead of calling an LLM.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
