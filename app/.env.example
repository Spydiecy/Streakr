# Streakr app environment. Copy to .env and fill in. Expo inlines any
# EXPO_PUBLIC_* var into the bundle at build time — see
# https://docs.expo.dev/guides/environment-variables/

# testnet | mainnet
EXPO_PUBLIC_NETWORK=testnet

# Firebase Web app config (Firebase console -> Project settings -> your web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# AWS Lambda Function URLs (backend/lambda/DEPLOY.md step 6) — each is its
# own standalone endpoint, not path suffixes on one shared base.
EXPO_PUBLIC_SENTIMENT_URL=https://your-sentiment-function-url.lambda-url.us-east-1.on.aws/
EXPO_PUBLIC_RESULT_CARD_URL=https://your-render-result-card-function-url.lambda-url.us-east-1.on.aws/

# Server-side faucet. REQUIRED for the demo wallet to be usable at all: the
# embedded key is generated in the browser, so it starts with 0 STT — and since
# STT is the gas token, it cannot send even the collateral token's own faucet()
# transaction. Leaving this unset means every first call fails with
# "Not enough tUSDC" and the in-app "Fund this wallet" button can't help.
EXPO_PUBLIC_FAUCET_URL=https://your-faucet-function-url.lambda-url.us-east-1.on.aws/

# WalletConnect Project ID (cloud.reown.com). Optional — without it the
# RainbowKit modal degrades to injected browser wallets only.
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=
