# Streakr app environment. Copy to .env and fill in. Expo inlines any
# EXPO_PUBLIC_* var into the bundle at build time — see
# https://docs.expo.dev/guides/environment-variables/

# testnet | mainnet
EXPO_PUBLIC_NETWORK=testnet

# Firebase Web app config (Firebase console -> Project settings -> your web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# AWS Lambda Function URLs (backend/lambda/DEPLOY.md step 6) — each is its
# own standalone endpoint, not path suffixes on one shared base.
EXPO_PUBLIC_SENTIMENT_URL=https://your-sentiment-function-url.lambda-url.us-east-1.on.aws/
EXPO_PUBLIC_RESULT_CARD_URL=https://your-render-result-card-function-url.lambda-url.us-east-1.on.aws/
